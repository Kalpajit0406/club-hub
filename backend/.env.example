# ============================================================
# ClubClash Backend Configuration (.env)
# ============================================================

# Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./clubclash.db

# JWT Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=clubclash-super-secret-jwt-key-change-in-production-2026-hackathon
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,https://club-hub-inky.vercel.app

# Firebase Integration (Project: club-hub-9c2de)
FIREBASE_ENABLED=False
FIREBASE_PROJECT_ID=club-hub-9c2de
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=club-hub-9c2de.firebasestorage.app

